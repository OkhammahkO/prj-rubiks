esphome:
  name: esp32-s3-cam-rubiks
  comment: Rubiks camera

esp32:
  board: esp32-s3-devkitc-1
  framework:
    type: arduino

# Pinout: https://emakefun.github.io/emakefun-docsify/zh-cn/esp32/esp32s3-cam/picture/esp32s3_cam_pin.png

# Exposed: GPIO0, GPIO1 GPIO14, GPIO41, GPIO42, GPIO43, GPIO44, GPIO46, GPIO47, GPIO48,

# +------------+--------+-----------------------------------+
# | FUNCTION   | GPIO   | NOTES                             |
# +------------+--------+-----------------------------------+
# | TM1638 STB | GPIO14 | safe baseline                     |  ✅ Working
# | TM1638 CLK | GPIO41 | debug pin, fine                   |  ✅ Working
# | TM1638 DIO | GPIO42 | debug pin, fine                   |  ✅ Working
# | SERVO 1    | GPIO43 | UART RX sacrificed                |  ✅ Working
# | SERVO 2    | GPIO44 | UART TX sacrificed                |  ✅ Working
# | BUZZER     | GPIO1  | conditional, boot/log sensitivity |  ✅ Working
# +------------+--------+-----------------------------------+

display:
  #TM1638:
  # https://esphome.io/components/display/tm1638.html
  # 5V
  platform: tm1638
  id: tm1638_display
  # Pins tested / confirmed working
  stb_pin: 14 # Yellow Wire
  clk_pin: 41 # Blue Wire
  dio_pin: 42 # Green Wire
  intensity: 1
  update_interval: 1s
  lambda: |-
    it.print("1234");

rtttl:
  output: rttl_output
  gain: 80%

button:
  - platform: template
    name: "Template Button"
    on_press:
      - rtttl.play:
          rtttl: "scale_up:d=32,o=5,b=100:c,c#,d#,e,f#,g#,a#,b"

  - platform: template
    name: "Servo 1 Left"
    on_press:
      - servo.write:
          id: servo1
          level: -100%

  - platform: template
    name: "Servo 1 Centre"
    on_press:
      - servo.write:
          id: servo1
          level: 0%

  - platform: template
    name: "Servo 1 Right"
    on_press:
      - servo.write:
          id: servo1
          level: 100%

  - platform: template
    name: "Servo 2 Left"
    on_press:
      - servo.write:
          id: servo2
          level: -100%

  - platform: template
    name: "Servo 2 Centre"
    on_press:
      - servo.write:
          id: servo2
          level: 0%

  - platform: template
    name: "Servo 2 Right"
    on_press:
      - servo.write:
          id: servo2
          level: 100%

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  # manual_ip:
  #   static_ip: 192.168.1.143
  #   gateway: 192.168.1.1
  #   subnet: 255.255.255.0
  ap: {}

logger:
api:
ota:
  - platform: esphome

psram:
  mode: octal
i2c:
  - id: camera_i2c
    sda: GPIO4
    scl: GPIO5

esp32_camera:
  name: esp_cam03
  external_clock:
    pin: GPIO15
    frequency: 20MHz
  i2c_id: camera_i2c
  data_pins: [GPIO11, GPIO9, GPIO8, GPIO10, GPIO12, GPIO18, GPIO17, GPIO16]
  vsync_pin: GPIO6
  href_pin: GPIO7
  pixel_clock_pin: GPIO13
  resolution: 320x240 # 320x240 , 640x480
  jpeg_quality: 10
  idle_framerate: 0.1 fps
  max_framerate: 3 fps
  vertical_flip: true
  horizontal_mirror: false # Good

  # --- image tuning ---
  brightness: 0
  contrast: 0
  saturation: 0

  # --- lock exposure ---
  aec_mode: manual
  aec_value: 1000 # adjust up/down until brightest square hits ~0.8 raw V

  # --- lock gain ---
  agc_mode: manual
  agc_value: 8 # fixed LED = no gain needed, minimises noise

  # --- fix white balance (not disable) ---
  wb_mode: sunny # or sunny if your LED is cool/daylight white

servo:
  - id: servo1
    output: servo_1
  - id: servo2
    output: servo_2

output:
  - platform: ledc
    pin: GPIO03
    channel: 2 # channel 1 is used for esp32_camera
    id: led
  #Rttl buzzer
  - platform: ledc
    pin: 1
    id: rttl_output
  #  Servo
  - platform: ledc
    pin: 43
    id: servo_1
    frequency: 50Hz
  #  Servo
  - platform: ledc
    pin: 44
    id: servo_2
    frequency: 50Hz

light:
  - platform: monochromatic
    output: led
    name: espcam_02 light
